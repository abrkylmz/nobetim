# ---------- Vercel'de ZORUNLU ----------
# Turso veritabanı (Vercel Marketplace → Turso entegrasyonu bunları otomatik ekler)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Blob (Storage → Blob → "Connect" ile otomatik eklenir)
BLOB_READ_WRITE_TOKEN=
# Dosya şifreleme anahtarı: 64 karakter hex. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DİKKAT: Değiştirilirse önceden yüklenmiş dosyalar okunamaz.
FILE_ENCRYPTION_KEY=
# Vercel Cron isteklerini doğrulamak için rastgele uzun bir değer
CRON_SECRET=

# ---------- İsteğe bağlı ----------
# Fotoğraf ve taranmış PDF okuma (OCR). Boşsa yalnızca Excel ve metin PDF okunur.
ANTHROPIC_API_KEY=
# Yüklenen dosyaların saklama süresi (gün)
FILE_RETENTION_DAYS=30

# ---------- Yalnızca yerel geliştirme ----------
# Turso adresi verilmezse data/nobetim.db, Blob anahtarı verilmezse data/uploads kullanılır.
PORT=8787
DATA_DIR=data
