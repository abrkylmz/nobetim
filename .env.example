# ---------- Vercel'de ZORUNLU ----------
# Neon Postgres (Vercel → Storage → Neon bağlandığında DATABASE_URL otomatik eklenir)
DATABASE_URL=
# Vercel Blob (Storage → Blob → projeye bağlandığında otomatik eklenir)
BLOB_READ_WRITE_TOKEN=
# Dosya şifreleme anahtarı: 64 karakter hex. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DİKKAT: Değiştirilirse önceden yüklenmiş dosyalar okunamaz.
FILE_ENCRYPTION_KEY=
# Vercel Cron isteklerini doğrulamak için rastgele uzun bir değer
CRON_SECRET=

# ---------- İsteğe bağlı ----------
# Fotoğraf ve taranmış PDF okuma (OCR). Boşsa yalnızca Excel ve metin PDF okunur.
ANTHROPIC_API_KEY=
# Yüklenen dosyaların saklama süresi (gün)
FILE_RETENTION_DAYS=30

# ---------- Yalnızca yerel geliştirme ----------
# DATABASE_URL verilmezse data/pg (PGlite, gömülü Postgres), Blob anahtarı verilmezse data/uploads kullanılır.
PORT=8787
DATA_DIR=data
